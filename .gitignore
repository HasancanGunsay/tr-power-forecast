# --- Data & models -----------------------------------------------------
# Datasets and model binaries never go into git. They bloat the repo forever
# and git cannot diff them anyway. Track how to *regenerate* them instead.
#
# Note the `dir/**` + re-include pattern below. Writing a plain `data/` would
# ignore the directory itself, and git then refuses to descend into it, so any
# later `!data/.gitkeep` exception is silently dead. Ignoring the *contents*
# (`data/**`) while re-including directories (`!data/**/`) keeps the exceptions
# reachable.
data/**
!data/**/
!data/**/.gitkeep

models/**
!models/**/
!models/**/.gitkeep

# Figures are tracked, unlike data and models. They are small, they are the
# project's public output, and the README embeds them — an ignored figure shows
# up on GitHub as a broken image. They are regenerated in full by
# `python -m powerforecast.analysis.figures`, so a stale one is never load-bearing.
reports/figures/**
!reports/figures/**/
!reports/figures/**/.gitkeep
!reports/figures/**/*.png

*.parquet
*.csv
*.pkl
*.joblib
*.pt
*.onnx

# --- Secrets -----------------------------------------------------------
.env
.env.*
!.env.example
*.key
credentials.json

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# --- Tooling caches ----------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Editors / OS ------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scheduled-run logs: local, noisy, and regenerated every day.
logs/
