# Copy to `.env` and fill in. `.env` itself is gitignored — never commit secrets.
# This file is committed so a new contributor knows which variables exist.

RANDOM_SEED=42

# --- EPİAŞ Şeffaflık (Türkiye) ------------------------------------------
# CAS authentication: these credentials are exchanged for a ticket-granting
# ticket, and every API call consumes a service ticket derived from it.
EPIAS_USERNAME=
EPIAS_PASSWORD=

# --- ENTSO-E Transparency (Europe) --------------------------------------
# Request access by emailing transparency@entsoe.eu with the subject
# "Restful API access", then generate the token under My Account Settings.
ENTSOE_API_KEY=

# Bidding zone to pull European data for (EIC code).
# 10Y1001A1001A83F = Germany/Luxembourg
ENTSOE_BIDDING_ZONE=10Y1001A1001A83F
